parameters:
    level: 7
    paths:
        - src
        - config
        - database
    checkOctaneCompatibility: true
    checkModelProperties: true
    # env() in config files is the documented Laravel idiom; the package's
    # config/ is its real config directory, so this rule is a false positive here.
    noEnvCallsOutsideOfConfig: false
    ignoreErrors:
        # HasReports and GivesReports are public, consumer-facing traits: host-app
        # models apply them. Those classes live outside this package, so PHPStan
        # can never observe the traits "used" in source. They are fully exercised
        # by the test suite.
        -
            identifier: trait.unused
            path: src/Traits/HasReports.php
        -
            identifier: trait.unused
            path: src/Traits/GivesReports.php
